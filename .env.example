# Copy to .env.local for local development and fill in real values.
# Never commit .env.local. In Vercel, set these under Project -> Settings -> Environment Variables.

# -----------------------------------------------------------------------------
# PUBLIC: safe to expose to the browser (NEXT_PUBLIC_ prefix).
# -----------------------------------------------------------------------------

# Canonical site URL, no trailing slash. Used for SEO, sitemaps and payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/publishable key. Safe in the browser because Row Level Security enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS: never prefix with NEXT_PUBLIC_, never import from client code.
# -----------------------------------------------------------------------------

# Supabase service-role key. Bypasses RLS. Used only for checkout and payment
# confirmation on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack -> Settings -> API Keys & Webhooks. Use sk_test_... in development.
PAYSTACK_SECRET_KEY=

# Transactional email (order confirmations) via Resend. Optional; emails are
# skipped (and logged) when unset.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "IMNY <orders@yourdomain.com>"
EMAIL_FROM=
